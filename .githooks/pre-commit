#!/usr/bin/env bash
# A commit cannot land red. This runs the full gate including perf budgets.
# Bypassing with --no-verify is blocked by .claude/hooks/guard-bash.sh and forbidden by CLAUDE.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# A commit that touches only docs/METRICS.md (the orchestrator's cost log) cannot break the
# build; skip the gate for it so logging does not cost a release build per item.
if [ "$(git diff --cached --name-only)" = "docs/METRICS.md" ]; then
    echo "metrics-only commit; gate skipped"
    exit 0
fi
exec scripts/check.sh full
