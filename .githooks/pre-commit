#!/usr/bin/env bash
# A commit cannot land red. This runs the full gate including perf budgets.
# Bypassing with --no-verify is blocked by .claude/hooks/guard-bash.sh and forbidden by CLAUDE.md.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# A commit that touches no build input (Sources/, Tests/, Package.swift, Resources/) cannot
# change what the gate would say; skip it so docs, plan, inbox and harness commits are cheap
# and do not contend with a subagent's release build (ADR-0017). Harness script changes are
# exercised by the next code commit.
if ! git diff --cached --name-only | grep -qE '^(Sources/|Tests/|Package\.swift|Resources/)'; then
    echo "no build inputs staged; gate skipped"
    exit 0
fi
exec scripts/check.sh full
