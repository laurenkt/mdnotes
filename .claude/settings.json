{
  "permissions": {
    "allow": [
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(swift run:*)",
      "Bash(swift package:*)",
      "Bash(xcrun swift-format:*)",
      "Bash(scripts/check.sh:*)",
      "Bash(scripts/bundle.sh:*)",
      "Bash(scripts/setup.sh:*)",
      "Bash(scripts/info-plist.sh:*)",
      "Bash(scripts/record-issue.sh:*)",
      "Bash(scripts/next-item.sh:*)",
      "Bash(scripts/verify-item.sh:*)",
      "Bash(scripts/task-brief.sh:*)",
      "Bash(scripts/log-metric.sh:*)",
      "Bash(scripts/absorb.sh:*)",
      "Bash(scripts/inbox-status.sh:*)",
      "Bash(scripts/record-seed.sh:*)",
      "Bash(git mv:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(plutil:*)",
      "Bash(mkdir:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git worktree:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcodegen:*)",
      "Bash(sudo:*)",
      "Read(~/Documents/MDnotes/**)",
      "Edit(~/Documents/MDnotes/**)",
      "Write(~/Documents/MDnotes/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "echo 'Context was compacted. If this session is running /loop /next-task, you are the orchestrator: nothing is lost, all state is in git. Continue the cycle: scripts/next-item.sh, one subagent per item, scripts/verify-item.sh. Do not implement tasks yourself and do not read PLAN.md, ISSUES.md or SPEC.md.'" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.swift) xcrun swift-format format --in-place \"$f\" ;; esac; exit 0" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh" }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh" }
        ]
      }
    ]
  }
}
